{
  "$defs": {
    "IssueExecutionModel": {
      "additionalProperties": false,
      "properties": {
        "block_trufflehog_unknown": {
          "default": true,
          "title": "Block Trufflehog Unknown",
          "type": "boolean"
        },
        "event_log": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Event Log"
        },
        "last_event_log": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Last Event Log"
        },
        "last_run_reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Last Run Reason"
        },
        "last_run_status": {
          "anyOf": [
            {
              "enum": [
                "pass",
                "fail",
                "blocked"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Last Run Status"
        },
        "min_coverage": {
          "default": 80.0,
          "maximum": 100.0,
          "minimum": 0.0,
          "title": "Min Coverage",
          "type": "number"
        },
        "min_tests": {
          "default": 15,
          "minimum": 0,
          "title": "Min Tests",
          "type": "integer"
        },
        "run_semgrep": {
          "default": false,
          "title": "Run Semgrep",
          "type": "boolean"
        },
        "run_trufflehog": {
          "default": false,
          "title": "Run Trufflehog",
          "type": "boolean"
        },
        "scan_output_dir": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Scan Output Dir"
        },
        "semgrep_block_levels": {
          "items": {
            "type": "string"
          },
          "title": "Semgrep Block Levels",
          "type": "array"
        },
        "semgrep_config": {
          "default": "auto",
          "title": "Semgrep Config",
          "type": "string"
        },
        "semgrep_sarif": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Semgrep Sarif"
        },
        "timeout_seconds": {
          "default": 120,
          "minimum": 1,
          "title": "Timeout Seconds",
          "type": "integer"
        },
        "trufflehog_json": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Trufflehog Json"
        }
      },
      "title": "IssueExecutionModel",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "acceptance_criteria": {
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "title": "Acceptance Criteria",
      "type": "array"
    },
    "assigned_to": {
      "minLength": 1,
      "title": "Assigned To",
      "type": "string"
    },
    "deployment": {
      "anyOf": [
        {
          "additionalProperties": true,
          "type": "object"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Deployment"
    },
    "execution": {
      "anyOf": [
        {
          "$ref": "#/$defs/IssueExecutionModel"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "goal": {
      "minLength": 1,
      "title": "Goal",
      "type": "string"
    },
    "issue_id": {
      "pattern": "^[A-Za-z][A-Za-z0-9_-]*-\\d+$",
      "title": "Issue Id",
      "type": "string"
    },
    "kill_criteria": {
      "items": {
        "type": "string"
      },
      "title": "Kill Criteria",
      "type": "array"
    },
    "output_location": {
      "minLength": 1,
      "title": "Output Location",
      "type": "string"
    },
    "priority": {
      "anyOf": [
        {
          "enum": [
            "P0",
            "P1",
            "P2",
            "P3"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Priority"
    },
    "required_artifacts": {
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "title": "Required Artifacts",
      "type": "array"
    },
    "requirements": {
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "title": "Requirements",
      "type": "array"
    },
    "status": {
      "enum": [
        "todo",
        "in_progress",
        "blocked",
        "done"
      ],
      "title": "Status",
      "type": "string"
    },
    "tech_stack": {
      "additionalProperties": {
        "type": "string"
      },
      "title": "Tech Stack",
      "type": "object"
    },
    "title": {
      "minLength": 1,
      "title": "Title",
      "type": "string"
    }
  },
  "required": [
    "issue_id",
    "title",
    "goal",
    "requirements",
    "output_location",
    "acceptance_criteria",
    "required_artifacts",
    "assigned_to",
    "status"
  ],
  "title": "IssueModel",
  "type": "object"
}
